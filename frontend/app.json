{
  "expo": {
    "name": "PG Manager",
    "slug": "pgms-owner-app",
    "scheme": "pgms",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.pgms.owner"
    },
    "ios": {
      "bundleIdentifier": "com.pgms.owner"
    },
    "extra": {
      "apiUrl": "http://192.168.1.1:8000"
    }
  }
}
