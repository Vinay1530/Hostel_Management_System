# Copy to `.env` and adjust for your machine / deployment.
# Expo inlines EXPO_PUBLIC_* values into the bundle when it starts or builds.

# Backend base URL.
#   Local Wi-Fi (phone on the same network): http://<your-lan-ip>:8000
#   Android emulator:                       http://10.0.2.2:8000
#   Cloud / production:                     https://api.yourdomain.com
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
