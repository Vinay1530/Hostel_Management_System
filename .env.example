# Copy to `.env` in the repository root. docker compose loads it automatically.
# Never commit `.env`; this template only contains safe placeholders.

POSTGRES_USER=pgms
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=pgms

# Signs all JWTs. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-strong-jwt-secret

# Production must be false, otherwise OTP codes are returned by the API.
OTP_DEV_MODE=true

# Initial password for manager-created tenant logins. Change it for production.
DEFAULT_TENANT_PASSWORD=change-me

# JSON array of browser origins allowed by CORS. Native apps are not affected.
# Example: ["https://app.yourdomain.com"]
CORS_ORIGINS=["*"]

# Only for running the backend outside Docker (uvicorn on the host).
# DATABASE_URL=postgresql+psycopg://pgms:pgms_dev@localhost:5433/pgms
